rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the MintexCare admin account. Being signed in is NOT enough -
    // any other account (even one created through the public API key) is treated as a visitor.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@mintexcare.com';
    }

    // Submissions collection: one document per submission (contact or career).
    // - Anyone can create (unauthenticated users submitting forms)
    // - Only the admin can read, update, or delete
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Legacy single-document submissions (kept for backward compat - no longer written to)
    match /appData/submissions {
      allow read, write: if isAdmin();
    }

    // All other app data (services, testimonials, team, gallery, jobs, contactInfo):
    // - Anyone can read (user panel displays this data publicly)
    // - Only the admin can write
    match /appData/{document} {
      allow read: if document != 'submissions';
      allow write: if isAdmin();
    }

    // Resume metadata: written by unauthenticated users (career form), read by admin only.
    match /resumeData/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Resume binary chunks: same policy as resumeData.
    match /resumeChunks/{chunkId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site images stored per-key to avoid the 1MB single-document limit.
    // Each document: siteImageData/{imageKey} -> { url: "..." }
    match /siteImageData/{imageKey} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
