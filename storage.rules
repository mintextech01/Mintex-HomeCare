rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Only the MintexCare admin account.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@mintexcare.com';
    }

    // Legacy resume folder - resumes are now stored in Firestore (resumeData),
    // so nothing writes here. Only the admin may read or clean up old files.
    match /resumes/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Uploaded images (site images, team photos, gallery, etc.)
    // - Anyone can read (user panel displays these images publicly)
    // - Only the admin can upload / delete
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
